{
  "name": "apercu-gmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extension Chrome pour voir et trier rapidement ses courriels Gmail (plusieurs comptes).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "node tests/e2e/popup.e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
