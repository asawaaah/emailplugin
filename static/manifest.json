{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "0.6.0",
  "default_locale": "fr",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage", "alarms", "notifications", "system.display", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["bubble.html", "bubble.js", "bubble.css", "base.css", "notify.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": ["https://gmail.googleapis.com/*", "https://oauth2.googleapis.com/*", "<all_urls>"]
}
